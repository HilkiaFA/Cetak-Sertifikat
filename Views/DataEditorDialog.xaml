<Window x:Class="CetakSertifikatApp.Views.DataEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Kelola &amp; Impor Data Penerima Sertifikat" Height="620" Width="980"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Quick Guide -->
            <RowDefinition Height="Auto" /> <!-- Template & Import Action Toolbar -->
            <RowDefinition Height="*" />    <!-- Data Grid -->
            <RowDefinition Height="Auto" /> <!-- Bottom Action Bar -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Click="BtnShowGuide_Click"
                        Padding="12,6" Background="#1D4ED8" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconLightbulb}" Width="13" Height="13" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Cara Enak Kumpulkan Data (Google Form)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Kelola Data Penerima &amp; Unduh Format Template" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" />
                    <TextBlock Text="Unduh template Excel untuk dibagikan ke panitia/peserta, atau tempel langsung data dari Google Sheets/Excel."
                               FontSize="12" Foreground="#3B82F6" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Action Toolbar -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <!-- Row 1: Unduh Template & Sumber Data -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="1. Unduh Template:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="BtnDownloadExcel" Click="BtnDownloadExcelTemplate_Click"
                            Padding="12,6" Margin="0,0,8,4" Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                            ToolTip="Unduh file Excel berisi format kolom variabel yang cocok dengan template sertifikat Anda">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDownload}" Width="13" Height="13" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Unduh Template Excel (.xlsx)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDownloadCsv" Click="BtnDownloadCsvTemplate_Click"
                            Padding="10,6" Margin="0,0,12,4" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDownload}" Width="12" Height="12" Stretch="Uniform" Fill="#334155" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Unduh Template CSV" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    
                    <Border Width="1" Background="#E2E8F0" Margin="0,0,12,4" />

                    <TextBlock Text="2. Masukkan / Impor Data:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="BtnImportExcel" Click="BtnImportExcel_Click"
                            Padding="12,6" Margin="0,0,8,4" Background="#0284C7" Foreground="White" BorderThickness="0" FontWeight="Medium" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFolderOpen}" Width="13" Height="13" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Buka File Excel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnImportCsv" Click="BtnImportCsv_Click"
                            Padding="10,6" Margin="0,0,8,4" Background="#0EA5E9" Foreground="White" BorderThickness="0" FontWeight="Medium" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDocument}" Width="12" Height="12" Stretch="Uniform" Fill="White" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Buka File CSV" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPasteClipboard" Click="BtnPasteClipboard_Click"
                            Padding="12,6" Margin="0,0,8,4" Background="#334155" Foreground="White" BorderThickness="0" FontWeight="Medium" Cursor="Hand"
                            ToolTip="Salin kolom dari Google Sheets atau Excel, lalu klik di sini untuk langsung memasukkan ratusan nama">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPaste}" Width="13" Height="13" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Tempel dari Clipboard (Ctrl+V)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Row 2: Edit Table & Tools -->
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Edit Tabel:" FontWeight="Medium" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="BtnAddRow" Click="BtnAddRow_Click"
                            Padding="9,5" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconAddRow}" Width="12" Height="12" Stretch="Uniform" Fill="#334155" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Tambah Baris" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAddColumn" Click="BtnAddColumn_Click"
                            Padding="9,5" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#0369A1" BorderBrush="#BAE6FD" Cursor="Hand"
                            ToolTip="Tambah kolom baru, misalnya {instansi}, {predikat}, {jurusan}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconAddColumn}" Width="12" Height="12" Stretch="Uniform" Fill="#0369A1" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Tambah Kolom Variabel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDeleteRow" Click="BtnDeleteRow_Click"
                            Padding="9,5" Margin="0,0,6,0" Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconTrash}" Width="11" Height="11" Stretch="Uniform" Fill="#991B1B" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Hapus Baris" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnGenerateMock" Click="BtnGenerateMock_Click"
                            Padding="10,5" Margin="0,0,6,0" Background="#F3E8FF" Foreground="#6B21A8" BorderBrush="#D8B4FE" Cursor="Hand"
                            ToolTip="Buat 25 nama peserta contoh Indonesia realistis otomatis untuk uji coba cetak">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDice}" Width="12" Height="12" Stretch="Uniform" Fill="#6B21A8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Buat Data Simulasi (25 Peserta)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnClearAll" Click="BtnClearAll_Click"
                            Padding="9,5" Margin="0,0,0,0" Background="#F1F5F9" Foreground="#64748B" BorderBrush="#CBD5E1" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBroom}" Width="11" Height="11" Stretch="Uniform" Fill="#64748B" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Kosongkan Tabel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="GridRecipients"
                      AutoGenerateColumns="True"
                      CanUserAddRows="True"
                      CanUserDeleteRows="True"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      RowHeaderWidth="36"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="#E2E8F0"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="30"
                      FontSize="13"
                      AutoGeneratingColumn="GridRecipients_AutoGeneratingColumn" />
        </Border>

        <!-- Bottom Actions -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtInfo" VerticalAlignment="Center" Foreground="#334155" FontWeight="Medium" FontSize="13" />
                <Path Data="{StaticResource IconLightbulb}" Width="12" Height="12" Stretch="Uniform" Fill="#64748B" Margin="10,0,4,0" VerticalAlignment="Center" />
                <TextBlock Text="Dobel klik sel tabel untuk mengedit langsung" VerticalAlignment="Center" Foreground="#64748B" FontSize="11" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Batal" IsCancel="True" Padding="16,8" Margin="0,0,8,0"
                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand" />
                <Button x:Name="BtnSaveApply" Click="BtnSaveApply_Click"
                        Padding="22,8" Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCheck}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Simpan &amp; Terapkan Data ke Sertifikat" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
