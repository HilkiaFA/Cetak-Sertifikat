<Window x:Class="CetakSertifikatApp.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ekspor Massal Sertifikat" Height="500" Width="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Ekspor Massal Sertifikat" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBlock x:Name="TxtSubtitle" Text="Mengekspor 100 sertifikat sesuai data penerima."
                       FontSize="13" Foreground="#64748B" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Configuration Options -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <!-- Export Format Selection -->
                <TextBlock Text="Pilihan Format Ekspor:" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                <RadioButton x:Name="RbMergedPdf" IsChecked="True" GroupName="ExportMode" Margin="0,0,0,8" Checked="ExportMode_Changed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconDocument}" Width="13" Height="13" Stretch="Uniform" Fill="#DC2626" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Satu PDF Gabungan (Semua sertifikat dalam 1 file)" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="RbIndividualPdf" GroupName="ExportMode" Margin="0,0,0,8" Checked="ExportMode_Changed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconMultiDoc}" Width="13" Height="13" Stretch="Uniform" Fill="#EA580C" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="File PDF Terpisah per Penerima ({nama}_{nomor}.pdf)" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="RbIndividualPng" GroupName="ExportMode" Margin="0,0,0,16" Checked="ExportMode_Changed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconImage}" Width="13" Height="13" Stretch="Uniform" Fill="#0284C7" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="File Gambar PNG Terpisah (Resolusi Cetak 300 DPI)" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <!-- Output Path Selection -->
                <TextBlock x:Name="LblTarget" Text="Lokasi Simpan File PDF Gabungan:" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtTargetPath" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Padding="8,0" IsReadOnly="True" Background="#F8FAFC" />
                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="Pilih Lokasi..." Click="BtnBrowse_Click"
                            Margin="8,0,0,0" Padding="12,0" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" />
                </Grid>

                <!-- Pattern options (for individual files) -->
                <StackPanel x:Name="PanelIndividualOptions" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Pola Penamaan File:" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtPattern" Text="{}{nama}_{nomor}" Height="30" VerticalContentAlignment="Center" Padding="6,0" />
                    <TextBlock Text="Variabel yang tersedia: {nama}, {nomor}, {peran}, dll." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Progress Section -->
                <StackPanel x:Name="PanelProgress" Visibility="Collapsed" Margin="0,10,0,0">
                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtProgressStatus" Text="Memproses sertifikat..." FontSize="12" Foreground="#334155" />
                        <TextBlock x:Name="TxtProgressPercent" Text="0%" DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="12" Foreground="#2563EB" />
                    </DockPanel>
                    <ProgressBar x:Name="PbExport" Height="14" Minimum="0" Maximum="100" Value="0" Foreground="#2563EB" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="BtnOpenResult" Click="BtnOpenResult_Click"
                    Visibility="Collapsed" Padding="14,8" Background="#F1F5F9" Foreground="#0284C7" BorderBrush="#BAE6FD" FontWeight="Medium" Cursor="Hand">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconFolderOpen}" Width="14" Height="14" Stretch="Uniform" Fill="#0284C7" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Buka Lokasi File" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="BtnCancel" Content="Tutup" Click="BtnCancel_Click"
                        Padding="16,8" Margin="0,0,8,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand" />
                <Button x:Name="BtnStartExport" Click="BtnStartExport_Click"
                        Padding="24,8" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRocket}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Mulai Ekspor" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
