<Window x:Class="CetakSertifikatApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CetakSertifikatApp"
        xmlns:controls="clr-namespace:CetakSertifikatApp.Controls"
        xmlns:conv="clr-namespace:CetakSertifikatApp.Converters"
        mc:Ignorable="d"
        Title="Aplikasi Cetak Sertifikat Massal" Height="780" Width="1200"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <conv:PtToDipConverter x:Key="PtToDipConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Toolbar -->
            <RowDefinition Height="Auto" /> <!-- DPI Warning Banner -->
            <RowDefinition Height="*" />    <!-- Main Content (Sidebar + Canvas) -->
            <RowDefinition Height="Auto" /> <!-- Bottom Record Navigator & Status -->
        </Grid.RowDefinitions>

        <!-- 1. Top Toolbar -->
        <Border Grid.Row="0" Background="#1E293B" Padding="14,10" SnapsToDevicePixels="True">
            <DockPanel LastChildFill="False">
                <!-- App Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Cetak Sertifikat Massal" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Left Actions -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BtnUploadBg_Click"
                            Padding="12,6" Margin="0,0,6,0" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconImage}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Upload Background" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="BtnManageData_Click"
                            Padding="12,6" Margin="0,0,6,0" Background="#0284C7" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconTable}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Kelola Data Penerima" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="BtnQuickDownloadExcel_Click"
                            Padding="12,6" Margin="0,0,6,0" Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                            ToolTip="Unduh file Excel kosong dengan format kolom yang sesuai dengan sertifikat ini untuk dibagikan ke peserta/panitia">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDownload}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Unduh Template Excel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="BtnLoadTemplate_Click"
                            Padding="10,6" Margin="0,0,6,0" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFolderOpen}" Width="13" Height="13" Stretch="Uniform" Fill="White" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Buka Template" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="BtnSaveTemplate_Click"
                            Padding="10,6" Margin="0,0,6,0" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSave}" Width="13" Height="13" Stretch="Uniform" Fill="White" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Simpan Template" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="BtnSampleTemplate_Click"
                            Padding="10,6" Margin="0,0,6,0" Background="#334155" Foreground="#E2E8F0" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Template Contoh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Actions: Print & Export -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Click="BtnPrint_Click"
                            Padding="14,7" Margin="0,0,8,0" Background="#475569" Foreground="White" BorderThickness="0" FontWeight="Medium" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPrint}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Cetak Langsung" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="BtnExportBatch_Click"
                            Padding="18,7" Background="#16A34A" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#40000000" />
                        </Button.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRocket}" Width="15" Height="15" Stretch="Uniform" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Ekspor Massal (PDF / PNG)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. DPI Warning Banner -->
        <Border Grid.Row="1" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="0,0,0,1"
                Padding="12,6"
                Visibility="{Binding DpiInfo.IsLowResolution, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <Path Data="{StaticResource IconWarning}" Width="16" Height="16" Stretch="Uniform" Fill="#D97706" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DpiInfo.Message}" Foreground="#92400E" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 3. Main Content: Sidebar + Canvas Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" MaxWidth="450" />
                <ColumnDefinition Width="Auto" /> <!-- Splitter -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Settings & Text Field Controls -->
            <ScrollViewer Grid.Column="0" Background="White" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16">
                    <!-- Page Size Section -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Ukuran Kertas Sertifikat" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding PageSizes}"
                                      SelectedItem="{Binding SelectedPageSize}"
                                      DisplayMemberPath="DisplayName"
                                      Height="30" VerticalContentAlignment="Center" Margin="0,0,0,6" />
                            
                            <StackPanel Visibility="{Binding IsCustomPageSize, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Lebar (mm):" FontSize="11" Foreground="#64748B" />
                                        <TextBox Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}" Height="26" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Tinggi (mm):" FontSize="11" Foreground="#64748B" />
                                        <TextBox Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}" Height="26" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="{Binding DpiInfo.Message}" FontSize="11" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Text Fields List Section -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <TextBlock Text="Daftar Kotak Teks" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Click="BtnAddField_Click"
                                            Padding="8,4" Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="0,0,4,0" ToolTip="Tambah kotak teks baru">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Stretch="Uniform" Fill="White" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Tambah" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnDuplicateField_Click"
                                            Padding="8,4" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="0,0,4,0" ToolTip="Duplikasi kotak teks (Ctrl+D)">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconDuplicate}" Width="11" Height="11" Stretch="Uniform" Fill="#334155" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Duplikat" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnDeleteField_Click"
                                            Padding="7,4" Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0" FontSize="11" Cursor="Hand" ToolTip="Hapus teks terpilih (Delete)">
                                        <Path Data="{StaticResource IconTrash}" Width="12" Height="12" Stretch="Uniform" Fill="#991B1B" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <!-- Clipboard & Undo Toolbar -->
                            <WrapPanel Margin="0,0,0,6">
                                <Button Click="BtnUndo_Click" IsEnabled="{Binding CanUndo}"
                                        Padding="6,3" Margin="0,0,3,3" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" FontSize="10" Cursor="Hand" ToolTip="Batalkan perubahan terakhir (Ctrl+Z)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconUndo}" Width="10" Height="10" Stretch="Uniform" Fill="#334155" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Undo" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnRedo_Click" IsEnabled="{Binding CanRedo}"
                                        Padding="6,3" Margin="0,0,3,3" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" FontSize="10" Cursor="Hand" ToolTip="Ulangi perubahan (Ctrl+Y)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconRedo}" Width="10" Height="10" Stretch="Uniform" Fill="#334155" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Redo" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnCut_Click" IsEnabled="{Binding HasSelectedField}"
                                        Padding="6,3" Margin="0,0,3,3" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" FontSize="10" Cursor="Hand" ToolTip="Potong kotak teks (Ctrl+X)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCut}" Width="10" Height="10" Stretch="Uniform" Fill="#334155" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Cut" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnCopy_Click" IsEnabled="{Binding HasSelectedField}"
                                        Padding="6,3" Margin="0,0,3,3" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" FontSize="10" Cursor="Hand" ToolTip="Salin kotak teks (Ctrl+C)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCopy}" Width="10" Height="10" Stretch="Uniform" Fill="#334155" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Copy" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnPaste_Click" IsEnabled="{Binding HasClipboardField}"
                                        Padding="6,3" Margin="0,0,3,3" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" FontSize="10" Cursor="Hand" ToolTip="Tempel kotak teks (Ctrl+V)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPaste}" Width="10" Height="10" Stretch="Uniform" Fill="#334155" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Paste" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- Field ListBox -->
                            <ListBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}"
                                     Height="110" BorderBrush="#CBD5E1" Background="White"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" Margin="4,2">
                                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" Foreground="#2563EB" Width="70" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Text}" Foreground="#475569" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Field Properties Editor (Active when SelectedField != null) -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12"
                            IsEnabled="{Binding HasSelectedField}">
                        <StackPanel DataContext="{Binding SelectedField}">
                            <TextBlock Text="Pengaturan Kotak Teks Terpilih" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10" />

                            <!-- Field ID -->
                            <TextBlock Text="ID / Nama Kotak:" FontSize="11" Foreground="#475569" />
                            <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,8" />

                            <!-- Text Content / Template -->
                            <TextBlock Text="Format Teks (Gunakan {variabel}):" FontSize="11" Foreground="#475569" />
                            <TextBox x:Name="TxtFieldText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" Margin="0,2,0,4" />

                            <!-- Variable insertion chips -->
                            <TextBlock Text="Klik variabel untuk menyisipkan:" FontSize="10" Foreground="#64748B" Margin="0,2,0,4" />
                            <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AvailableVariables}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Margin="0,0,0,10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding StringFormat='{}{{{0}}}'}"
                                                Click="BtnInsertVariable_Click"
                                                Padding="6,2" Margin="0,0,4,4" FontSize="10"
                                                Background="#E0F2FE" Foreground="#0369A1" BorderBrush="#BAE6FD" Cursor="Hand" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Font Family -->
                            <TextBlock Text="Jenis Font (Terpasang di Komputer):" FontSize="11" Foreground="#475569" />
                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.InstalledFonts}"
                                      SelectedItem="{Binding FontFamily}"
                                      Height="28" Margin="0,2,0,8" />

                            <!-- Font Size & Styles -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Ukuran Font (pt):" FontSize="11" Foreground="#475569" />
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="8" Maximum="72" Value="{Binding FontSize}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Content="B" IsChecked="{Binding IsBold}" FontWeight="Bold" Width="28" Height="28" Margin="0,0,4,0" Cursor="Hand" />
                                        <ToggleButton Content="I" IsChecked="{Binding IsItalic}" FontStyle="Italic" Width="28" Height="28" Cursor="Hand" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Color Picker -->
                            <TextBlock Text="Warna Teks (Hex atau Palet):" FontSize="11" Foreground="#475569" />
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding Brush}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Height="28" Margin="0,0,4,0" />
                                <TextBox Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" />
                                <Button Grid.Column="2" Click="BtnPickColor_Click" Margin="4,0,0,0" Width="32" Height="28" Cursor="Hand" ToolTip="Pilih Warna">
                                    <Path Data="{StaticResource IconPalette}" Width="14" Height="14" Stretch="Uniform" Fill="#334155" VerticalAlignment="Center" />
                                </Button>
                            </Grid>

                            <!-- Quick Color Swatches -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Background="#1A1A1A" Width="20" Height="20" Margin="0,0,4,0" Tag="#1A1A1A" Click="Swatch_Click" Cursor="Hand" ToolTip="Hitam Arang" />
                                <Button Background="#0F2027" Width="20" Height="20" Margin="0,0,4,0" Tag="#0F2027" Click="Swatch_Click" Cursor="Hand" ToolTip="Biru Navy Gelap" />
                                <Button Background="#C5A059" Width="20" Height="20" Margin="0,0,4,0" Tag="#C5A059" Click="Swatch_Click" Cursor="Hand" ToolTip="Emas Klasik" />
                                <Button Background="#8C7341" Width="20" Height="20" Margin="0,0,4,0" Tag="#8C7341" Click="Swatch_Click" Cursor="Hand" ToolTip="Bronze / Gold Tua" />
                                <Button Background="#1E3A8A" Width="20" Height="20" Margin="0,0,4,0" Tag="#1E3A8A" Click="Swatch_Click" Cursor="Hand" ToolTip="Biru Royal" />
                                <Button Background="#7F1D1D" Width="20" Height="20" Margin="0,0,4,0" Tag="#7F1D1D" Click="Swatch_Click" Cursor="Hand" ToolTip="Merah Marun" />
                                <Button Background="#064E3B" Width="20" Height="20" Margin="0,0,4,0" Tag="#064E3B" Click="Swatch_Click" Cursor="Hand" ToolTip="Hijau Emerald" />
                            </StackPanel>

                            <!-- Alignment -->
                            <TextBlock Text="Perataan Teks:" FontSize="11" Foreground="#475569" />
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Kiri" Click="AlignLeft_Click" Margin="0,0,2,0" Padding="0,4" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" />
                                <Button Grid.Column="1" Content="Tengah" Click="AlignCenter_Click" Margin="2,0,2,0" Padding="0,4" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" />
                                <Button Grid.Column="2" Content="Kanan" Click="AlignRight_Click" Margin="2,0,0,0" Padding="0,4" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" />
                            </Grid>

                            <!-- Position X, Y, BoxWidth in Millimeters -->
                            <TextBlock Text="Posisi &amp; Lebar (dalam Milimeter):" FontSize="11" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="X (mm):" FontSize="10" Foreground="#64748B" />
                                    <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                    <TextBlock Text="Y (mm):" FontSize="10" Foreground="#64748B" />
                                    <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="Lebar (mm):" FontSize="10" Foreground="#64748B" />
                                    <TextBox Text="{Binding BoxWidth, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Centering Quick Buttons -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="BtnCenterField_Click"
                                        Padding="4,4" Margin="0,0,3,0" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" FontSize="11" Cursor="Hand" ToolTip="Posisikan teks persis di tengah halaman (Center X)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCenterH}" Width="12" Height="12" Stretch="Uniform" Fill="#1D4ED8" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Tengahkan Horisontal" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Click="BtnCenterFieldV_Click"
                                        Padding="4,4" Margin="3,0,0,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" FontSize="11" Cursor="Hand" ToolTip="Posisikan teks persis di tengah tinggi halaman (Center Y)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCenterV}" Width="12" Height="12" Stretch="Uniform" Fill="#334155" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Tengahkan Vertikal" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Nudge Arrow Controls & Keyboard Hint -->
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Geser Posisi (Arrow Keys):" FontSize="10" FontWeight="SemiBold" Foreground="#334155" />
                                        <TextBlock Text="Panah keyboard (Shift = cepat, Ctrl = mikro)" FontSize="9" Foreground="#64748B" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Click="BtnNudgeLeft_Click" Width="26" Height="24" Margin="0,0,2,0" Background="White" BorderBrush="#CBD5E1" Cursor="Hand" ToolTip="Geser Kiri (Panah Kiri)">
                                            <Path Data="{StaticResource IconArrowLeft}" Width="8" Height="8" Stretch="Uniform" Fill="#334155" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Click="BtnNudgeUp_Click" Width="26" Height="24" Margin="0,0,2,0" Background="White" BorderBrush="#CBD5E1" Cursor="Hand" ToolTip="Geser Atas (Panah Atas)">
                                            <Path Data="{StaticResource IconArrowUp}" Width="8" Height="8" Stretch="Uniform" Fill="#334155" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Click="BtnNudgeDown_Click" Width="26" Height="24" Margin="0,0,2,0" Background="White" BorderBrush="#CBD5E1" Cursor="Hand" ToolTip="Geser Bawah (Panah Bawah)">
                                            <Path Data="{StaticResource IconArrowDown}" Width="8" Height="8" Stretch="Uniform" Fill="#334155" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Click="BtnNudgeRight_Click" Width="26" Height="24" Background="White" BorderBrush="#CBD5E1" Cursor="Hand" ToolTip="Geser Kanan (Panah Kanan)">
                                            <Path Data="{StaticResource IconArrowRight}" Width="8" Height="8" Stretch="Uniform" Fill="#334155" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Auto-shrink CheckBox -->
                            <CheckBox IsChecked="{Binding AutoShrink}" Margin="0,0,0,4">
                                <TextBlock Text="Auto-shrink (Kecilkan font otomatis jika nama/teks panjang agar tidak keluar batas)"
                                           FontSize="11" TextWrapping="Wrap" Foreground="#1E293B" />
                            </CheckBox>

                            <!-- Snap to Center CheckBox -->
                            <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SnapToCenterEnabled}" Margin="0,4,0,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Smart Snap (Titik tengah item otomatis menempel ke garis tengah saat digeser)"
                                               FontSize="11" TextWrapping="Wrap" Foreground="#1E293B" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#CBD5E1" Cursor="SizeWE" />

            <!-- CENTER: Interactive Certificate Canvas & Zoom Toolbar -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Canvas Control Bar -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,6">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Pratinjau Kanvas:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Klik &amp; geser kotak teks pada kanvas untuk memindahkan posisi. Tarik ujung kanan untuk mengubah lebar."
                                       FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Zoom Controls -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Click="BtnZoomOut_Click" Padding="6,4" Margin="0,0,4,0" Background="#E2E8F0" BorderThickness="0" Cursor="Hand" ToolTip="Perkecil Tampilan">
                                <Path Data="{StaticResource IconZoomOut}" Width="11" Height="11" Stretch="Uniform" Fill="#334155" VerticalAlignment="Center" />
                            </Button>
                            <TextBlock Text="{Binding ZoomPercentage, StringFormat='{}{0}%'}" Width="40" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Medium" Foreground="#334155" />
                            <Button Click="BtnZoomIn_Click" Padding="6,4" Margin="4,0,4,0" Background="#E2E8F0" BorderThickness="0" Cursor="Hand" ToolTip="Perbesar Tampilan">
                                <Path Data="{StaticResource IconZoomIn}" Width="11" Height="11" Stretch="Uniform" Fill="#334155" VerticalAlignment="Center" />
                            </Button>
                            <Button Click="BtnZoomFit_Click" Padding="8,4" Margin="4,0,0,0" Background="#E2E8F0" BorderThickness="0" FontSize="11" Cursor="Hand" ToolTip="Sesuaikan Ukuran Layar">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconZoomFit}" Width="11" Height="11" Stretch="Uniform" Fill="#334155" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Pas Layar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- The Interactive Canvas -->
                <controls:CertificateCanvas Grid.Row="1" />
            </Grid>
        </Grid>

        <!-- 4. Bottom Record Navigator & Status Bar -->
        <Border Grid.Row="3" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel LastChildFill="True">
                <!-- Navigation Buttons (Prev / Next / Sample Check) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Pratinjau Data:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" />
                    <Button Click="BtnFirstRec_Click" Padding="8,5" Margin="0,0,4,0" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Pertama">
                        <Path Data="{StaticResource IconFirstPage}" Width="10" Height="10" Stretch="Uniform" Fill="White" VerticalAlignment="Center" />
                    </Button>
                    <Button Click="BtnPrevRec_Click" Padding="9,5" Margin="0,0,4,0" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Sebelumnya">
                        <Path Data="{StaticResource IconPrevPage}" Width="8" Height="8" Stretch="Uniform" Fill="White" VerticalAlignment="Center" />
                    </Button>
                    
                    <Border Background="#0F172A" CornerRadius="4" Padding="10,3" Margin="0,0,4,0">
                        <TextBlock Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Penerima {0} dari {1}">
                                    <Binding Path="CurrentRecipientIndexDisplay" />
                                    <Binding Path="TotalRecipients" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>

                    <Button Click="BtnNextRec_Click" Padding="9,5" Margin="0,0,4,0" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Berikutnya">
                        <Path Data="{StaticResource IconNextPage}" Width="8" Height="8" Stretch="Uniform" Fill="White" VerticalAlignment="Center" />
                    </Button>
                    <Button Click="BtnLastRec_Click" Padding="8,5" Margin="0,0,14,0" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Terakhir">
                        <Path Data="{StaticResource IconLastPage}" Width="10" Height="10" Stretch="Uniform" Fill="White" VerticalAlignment="Center" />
                    </Button>

                    <!-- Active Recipient Name Pill -->
                    <Border Background="#334155" CornerRadius="4" Padding="10,3">
                        <TextBlock Text="{Binding CurrentRecipient.Data[nama], FallbackValue='Nama Peserta'}"
                                   Foreground="White" FontWeight="Medium" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                    </Border>
                </StackPanel>

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
