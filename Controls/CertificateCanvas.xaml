<UserControl x:Class="CetakSertifikatApp.Controls.CertificateCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CetakSertifikatApp.Controls"
             xmlns:conv="clr-namespace:CetakSertifikatApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:PtToDipConverter x:Key="PtToDipConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="#E5E7EB">
        <!-- Scrollable & Zoomable Container -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Focusable="False">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                </Grid.LayoutTransform>

                <!-- Certificate Paper Page (Drop Shadow + White Background) -->
                <Border Width="{Binding CanvasWidthDip}" Height="{Binding CanvasHeightDip}"
                        Background="White"
                        BorderBrush="#CBD5E1" BorderThickness="1"
                        CornerRadius="2"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#20000000" />
                    </Border.Effect>

                    <Grid ClipToBounds="True">
                        <!-- 1. Background Image -->
                        <Image Source="{Binding BackgroundImageSource}" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- 2. Interactive Canvas for Text Fields -->
                        <Canvas x:Name="FieldCanvas" Background="Transparent"
                                Focusable="True"
                                PreviewMouseDown="FieldCanvas_PreviewMouseDown"
                                PreviewMouseMove="FieldCanvas_PreviewMouseMove"
                                PreviewMouseUp="FieldCanvas_PreviewMouseUp">
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding CanvasWidthDip}" Height="{Binding CanvasHeightDip}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding CanvasWidth}"
                                              Tag="FieldElement"
                                              Cursor="SizeAll"
                                              Background="Transparent"
                                              Margin="-4,-4,-4,-4">
                                            <!-- Visual Selection Border -->
                                            <Border BorderThickness="1.5"
                                                    Margin="4"
                                                    CornerRadius="2"
                                                    SnapsToDevicePixels="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                                                <Setter Property="Background" Value="#102563EB" />
                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=IsMouseOver}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="BorderBrush" Value="#94A3B8" />
                                                                <Setter Property="Background" Value="#0A000000" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <!-- Text Content -->
                                                <TextBlock Text="{Binding PreviewText}"
                                                           FontFamily="{Binding FontFamily}"
                                                           FontSize="{Binding EffectiveFontSize, Converter={StaticResource PtToDipConverter}}"
                                                           Foreground="{Binding Brush}"
                                                           FontWeight="{Binding FontWeight}"
                                                           FontStyle="{Binding FontStyle}"
                                                           TextAlignment="{Binding TextAlignment}"
                                                           TextWrapping="NoWrap"
                                                           VerticalAlignment="Center"
                                                           Padding="2,1" />
                                            </Border>

                                            <!-- Center Point Anchor (Titik Tengah Item) -->
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Width="16" Height="16"
                                                  Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                  IsHitTestVisible="False"
                                                  ToolTip="Titik Pusat Item">
                                                <Ellipse Width="10" Height="10" Stroke="#EF4444" StrokeThickness="1.5" Fill="#30EF4444" />
                                                <Ellipse Width="4" Height="4" Fill="#EF4444" />
                                                <Line X1="0" Y1="8" X2="16" Y2="8" Stroke="#EF4444" StrokeThickness="1" />
                                                <Line X1="8" Y1="0" X2="8" Y2="16" Stroke="#EF4444" StrokeThickness="1" />
                                            </Grid>

                                            <!-- Top Center Marker Notch -->
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                                                    Width="7" Height="6" Background="#EF4444" CornerRadius="1"
                                                    Margin="0,1,0,0"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                    IsHitTestVisible="False" />

                                            <!-- Bottom Center Marker Notch -->
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                    Width="7" Height="6" Background="#EF4444" CornerRadius="1"
                                                    Margin="0,0,0,1"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                    IsHitTestVisible="False" />

                                            <!-- Coordinate Badge (Visible when selected) -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="4,-16,0,0"
                                                    Padding="4,1"
                                                    Background="#1E293B" CornerRadius="2"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                    IsHitTestVisible="False">
                                                <TextBlock Foreground="White" FontSize="9" FontFamily="Consolas">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} | X:{1:F1} Y:{2:F1} W:{3:F1}mm">
                                                            <Binding Path="Id" />
                                                            <Binding Path="X" />
                                                            <Binding Path="Y" />
                                                            <Binding Path="BoxWidth" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>

                                            <!-- Right Resize Handle (Grip) -->
                                            <Border Width="8" HorizontalAlignment="Right"
                                                    Background="#2563EB"
                                                    CornerRadius="2"
                                                    Margin="0,6,2,6"
                                                    Cursor="SizeWE"
                                                    Tag="ResizeGrip"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Smart Alignment Guidelines (Garis Pandu Snap ke Titik Tengah) -->
                            <Line x:Name="VerticalGuideLine" Stroke="#EF4444" StrokeThickness="1.5"
                                  StrokeDashArray="4 3" Visibility="Collapsed" IsHitTestVisible="False" />
                            <Line x:Name="HorizontalGuideLine" Stroke="#EF4444" StrokeThickness="1.5"
                                  StrokeDashArray="4 3" Visibility="Collapsed" IsHitTestVisible="False" />

                            <!-- Magnetic Guide Badge -->
                            <Border x:Name="GuideBadge" Background="#EF4444" CornerRadius="3"
                                    Padding="8,3" Visibility="Collapsed" IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#40000000" />
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconTarget}" Width="11" Height="11" Stretch="Uniform" Fill="White" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GuideBadgeText" Text="Tengah Kanvas"
                                               Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
